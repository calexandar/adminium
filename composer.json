{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "calexandar/adminium",
    "type": "library",
    "description": "A modular Laravel admin panel and CMS built with Tailwind CSS.",
    "keywords": [
        "laravel",
        "admin",
        "cms",
        "panel"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "laravel/framework": "^12.0|^13.0",
        "kra8/laravel-snowflake": "^2.4",
        "spatie/laravel-medialibrary": "^11.15",
        "spatie/laravel-permission": "^6.21",
        "spatie/laravel-translatable": "^6.11"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.24",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^4.1",
        "pestphp/pest-plugin-laravel": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Calexandar\\Adminium\\": "src/",
            "Calexandar\\Adminium\\Database\\Factories\\": "database/factories/",
            "Calexandar\\Adminium\\Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Calexandar\\Adminium\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Calexandar\\Adminium\\AdminiumServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "1.0.x-dev"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "test": "pest",
        "pint": "pint",
        "phpstan": "phpstan analyse"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
